# ==============================================================================
# Environment Configuration (Reference from PRD Appendix C)
# IMPORTANT: DO NOT commit real secrets or production keys to source control.
# ==============================================================================

# Supabase Local/Hosted Project URL (e.g., http://127.0.0.1:54321 for local)
SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anonymous Key (Client-safe public API key)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (Secret, backend-only key bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# LLM Provider identifier (e.g., openai, anthropic, google)
LLM_PROVIDER=openai

# Model used for fast tier tasks (summarization, scoring, tags)
LLM_MODEL_FAST=gpt-4o-mini

# Model used for strong tier tasks (verdicts, guides, graph-changes)
LLM_MODEL_STRONG=gpt-4o

# API key for the selected LLM provider
LLM_API_KEY=your_llm_api_key_here

# Daily limit for on-demand roadmap analysis per free user
FREE_TIER_DAILY_ANALYSES=10

# PostHog Project API Key for product analytics and telemetry
POSTHOG_KEY=your_posthog_key_here
