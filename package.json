{
  "name": "ai-upskilling-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter mobile-web web",
    "web": "pnpm --filter mobile-web web",
    "ios": "pnpm --filter mobile-web ios",
    "android": "pnpm --filter mobile-web android",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "web:export": "cd apps/mobile-web && EXPO_NO_TELEMETRY=1 HOME=/tmp npx expo export -p web --no-minify",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "graph:validate": "tsx scripts/validate-graph.ts",
    "graph:seed": "tsx scripts/seed-graph.ts",
    "grant-editor": "tsx scripts/grant-editor.ts",
    "llm:smoke": "tsx packages/llm/src/smoke.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "jest-expo": "^58.0.15",
    "prettier": "^3.10.1",
    "@supabase/supabase-js": "^2.119.0",
    "supabase": "^3.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0"
  }
}
