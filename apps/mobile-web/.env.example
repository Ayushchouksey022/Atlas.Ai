# ==============================================================================
# Client-side Environment Variables (Expo Public)
# Accessible in client code via process.env.EXPO_PUBLIC_*
# ==============================================================================

# Supabase API URL for the Expo mobile & web client
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anonymous Key for client auth and queries
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PostHog API Key for client analytics
EXPO_PUBLIC_POSTHOG_KEY=your_posthog_key_here
